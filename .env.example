GITHUB_TOKEN=your_github_token_here
WEBHOOK_SECRET=your_custom_webhook_secret_string

# development environment variables
# CHROMA_BASE_URL=http://chromadb:8000

# production environment variables
# GEMINI_API_KEY=your_gemini_api_key_here
# PINECONE_API_KEY=your_pinecone_api_key_here

# Set the environment to either 'development' or 'production' to switch between local and cloud configurations
# ENVIRONMENT=production | development

# Logging Configuration
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TYPE=console                    # console, file, both, cloud
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_SIZE=10485760         # 10MB in bytes
LOG_FILE_BACKUP_COUNT=5
LOG_FORMAT=json                     # json or text